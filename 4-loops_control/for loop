/* loop control statements
   to repeat some parts of the program 
   types are - 
         (1) for loop
               for(initiaisation;condition;updation){
               //do something
               }  
         (2) while loop
         (3) do-while loop
*/
#include<stdio.h>
int main(){
   for(int i=1 ; i<=5 ; i=i+1){     // (i=i+1) = (i+=1) = (i++)
       printf("hello world \n" , i);
   }
   for(float k=1.0 ; k<=5.0 ; k=k+1){
      printf("%f \n",k);
   }
   for(char ch ='a';ch<='z';ch++){
      printf("%c \n",ch);
   }

// infinite loop where condition is left empty and we should not create it

   return 0;
}

